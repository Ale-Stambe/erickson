<div class="hub-slider-video">

    <div class="hub-slider-video__slide"> 
        <div class="hub-video-youtube" data-youtube-id="85TVbPrTkOo">
            <img
                class="hub-video-youtube__cover"
                src="https://img.youtube.com/vi/85TVbPrTkOo/maxresdefault.jpg"
                alt="Guarda il video"
                loading="lazy"
            >
            <button class="hub-video-youtube__play" type="button" aria-label="Riproduci il video">
                ▶
            </button>
        </div>
    </div>

</div>



<style>

.hub-slider-video {
    width: 100%;
}

.hub-video-youtube {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    border-radius: 12px;
}

.hub-video-youtube__cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hub-video-youtube iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
}

.hub-video-youtube__play {
    position: absolute;
    bottom: 15px;
    right: 15px;

    width: 64px;
    height: 64px;

    padding: 0;
    border: 0;
    border-radius: 50%;

    background: rgba(0, 0, 0, 0.75);
    color: #fff;

    font-size: 28px;
    line-height: 64px;
    text-align: center;

    cursor: pointer;
}

.zambotti .hub-video-youtube__play{
    bottom: unset !important;
    right: unset !important;
left: 15px;
top: 15px;
}
</style>


<script>
require(['jquery'], function ($) {

    $(document).on('click', '.hub-video-youtube', function () {

        var container = $(this);
        var videoId = container.data('youtube-id');

        if (container.hasClass('video-loaded')) {
            return;
        }

        if (!videoId) {
            return;
        }

        container.addClass('video-loaded');

        var iframe = $('<iframe>', {

            src:
                'https://www.youtube.com/embed/' +
                videoId +
                '?autoplay=1',

            title: 'Video YouTube',

            allow:
                'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',

            allowfullscreen: true

        });

        container.empty().append(iframe);

    });

});
</script>              
